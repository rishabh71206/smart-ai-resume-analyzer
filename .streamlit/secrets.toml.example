# Copy to .streamlit/secrets.toml for local development, or paste the same
# values into Streamlit Cloud -> App settings -> Secrets.
#
# The app works without a key: it falls back to the deterministic offline
# engine. Add a key to enable Gemini-written feedback.
GEMINI_API_KEY = "your_google_gemini_api_key_here"

# Optional overrides
# GEMINI_MODEL = "gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash"
# AI_TIMEOUT_SECONDS = "60"
# AI_MAX_RETRIES = "2"
