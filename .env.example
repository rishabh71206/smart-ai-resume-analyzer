# Copy this file to .env for local development.
# On Streamlit Cloud, add the same keys in App settings -> Secrets.

# Required for Gemini-powered responses. Leave empty to use the offline engine.
GEMINI_API_KEY=

# Optional: comma-separated fallback list, tried in order.
# GEMINI_MODEL=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash

# Optional: request timeout in seconds and retries per model.
# AI_TIMEOUT_SECONDS=60
# AI_MAX_RETRIES=2
